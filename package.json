{
  "name": "poketto",
  "version": "1.0.0",
  "description": "A Pokemon-themed web application",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "npm run build:css && npm run build:js",
    "build:css": "postcss src/styles/main.css -o public/css/style.css",
    "build:js": "browserify src/js/main.js -o public/js/bundle.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [
    "pokemon",
    "pokedex",
    "web-app",
    "javascript",
    "node"
  ],
  "author": "Asnan07",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.15",
    "browserify": "^17.0.0",
    "eslint": "^8.48.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "postcss": "^8.4.29",
    "postcss-cli": "^10.1.0",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
